[Unit]
Description=Collect AI news from RSS sources and insert into Supabase
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
EnvironmentFile=/root/.config/news-collector.env
ExecStart=/home/ubuntu/.nvm/versions/node/v24.20.0/bin/node /home/ubuntu/apps/personal-website/ops/news-collector/collect-news.mjs
WorkingDirectory=/home/ubuntu/apps/personal-website
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
